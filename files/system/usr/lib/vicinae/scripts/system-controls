#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title System Controls
# @vicinae.mode dmenu
# @vicinae.description Power, session, and display management

set -euo pipefail

SELECTION="$(printf '%s\n' \
    'Power off' \
    'Reboot' \
    'Lock screen' \
    'Suspend' \
    'Log out' \
    'Toggle night mode' \
    'Toggle notifications' \
    'Keyboard layout' \
    'Restart Vicinae' \
    'Display settings' \
    | vicinae dmenu --placeholder 'System control...')"

case "${SELECTION}" in
    'Power off')            systemctl poweroff ;;
    'Reboot')               systemctl reboot ;;
    'Lock screen')          vicinae vicinae://extensions/vicinae-dms/dms-lock ;;
    'Suspend')              systemctl suspend ;;
    'Log out')              loginctl terminate-user "$(id -un)" ;;
    'Toggle night mode')    dms ipc call nightlight toggle ;;
    'Toggle notifications') dms ipc call notifications toggle ;;
    'Keyboard layout')      niri msg action switch-layout next ;;
    'Restart Vicinae')      vicinae server --replace ;;
    'Display settings')     setsid wdisplays >/dev/null 2>&1 & ;;
    *) ;;
esac
