#!/home/linuxbrew/.linuxbrew/bin/python3
"""Generate ~/.config/hypr/pop-windows.conf from YAML sources.

Reads /usr/share/tarion/hypr/pop-windows.yaml (distro defaults) and
~/.config/hypr/pop-windows.yaml (user overrides), merges them by name
(user wins), and writes ~/.config/hypr/pop-windows.conf using Hyprland
0.53+ named windowrule block syntax.

Always writes the output file — even when both sources are empty — so
that `source = ~/.config/hypr/pop-windows.conf` in hyprland.conf never
fails with a missing-file error.
"""

import os
import subprocess
import sys

DISTRO_YAML = "/usr/share/tarion/hypr/pop-windows.yaml"
USER_YAML = os.path.expanduser("~/.config/hypr/pop-windows.yaml")
OUT_CONF = os.path.expanduser("~/.config/hypr/pop-windows.conf")

HEADER = "# Auto-generated by hypr-pop-windows-gen — do not edit\n"


def load_yaml(path):
    try:
        import yaml
    except ImportError:
        print("Error: pyyaml is required — run: /home/linuxbrew/.linuxbrew/bin/pip3 install pyyaml", file=sys.stderr)
        sys.exit(1)

    if not os.path.exists(path):
        return []
    with open(path, encoding="utf-8") as f:
        data = yaml.safe_load(f)
    return data or []


def merge_entries(distro, user):
    merged = {entry["name"]: entry for entry in distro}
    for entry in user:
        merged[entry["name"]] = entry
    return list(merged.values())


def entry_to_conf(entry):
    name = entry["name"]
    class_re = entry["class"]
    title = entry.get("title")
    size = entry.get("size", "1300 900")
    position = entry.get("position", "center")

    lines = [
        "windowrule {",
        f"    name = pop-{name}",
        f"    match:class = {class_re}",
    ]
    if title:
        lines.append(f"    match:title = {title}")
    lines += [
        "    float = true",
        "    pin = true",
        f"    size = {size}",
    ]
    if position == "center":
        lines.append("    center = true")
    else:
        lines.append(f"    move = {position}")
    lines.append("}")
    return "\n".join(lines)


def main():
    distro = load_yaml(DISTRO_YAML)
    user = load_yaml(USER_YAML)
    entries = merge_entries(distro, user)

    os.makedirs(os.path.dirname(OUT_CONF), exist_ok=True)

    with open(OUT_CONF, "w", encoding="utf-8") as f:
        f.write(HEADER)
        if entries:
            f.write("\n")
            f.write("\n\n".join(entry_to_conf(e) for e in entries))
            f.write("\n")

    # Reload Hyprland if running in the current session
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], check=False, capture_output=True)


if __name__ == "__main__":
    main()
