#!/usr/bin/env bash
# Tarion configuration synchronization utility
# Maintains skeleton configs in ~/.local/share/tarion/ with user overrides in ~/.config/
set -euo pipefail

source /usr/lib/tarion/xdg-paths.sh

SKEL_DIR="/usr/share/tarion/skel"
LOCAL_DIR="${HOME}/.local/share/tarion"
USER_DIR="${HOME}/.config"
STATE_DIR=$(get_tarion_cache_dir)
MANIFEST="${STATE_DIR}/skel-manifest"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

FORCE=false
SHOW_DIFF_FILE=""
LIST_CHANGES=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --force)
            FORCE=true
            shift
            ;;
        --diff)
            SHOW_DIFF_FILE="$2"
            shift 2
            ;;
        --list)
            LIST_CHANGES=true
            shift
            ;;
        *)
            echo "Usage: tarion-sync [--force] [--diff <file>] [--list]"
            exit 1
            ;;
    esac
done

log_info() { echo -e "${GREEN}✓${NC} $*"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $*"; }
log_error() { echo -e "${RED}✗${NC} $*" >&2; }

# Get file SHA256
sha256_file() {
    sha256sum "${1}" 2>/dev/null | awk '{print $1}'
}

# Read manifest
read_manifest() {
    if [ -f "${MANIFEST}" ]; then
        cat "${MANIFEST}"
    fi
}

# Write manifest
write_manifest() {
    local content="${1}"
    mkdir -p "$(dirname "${MANIFEST}")"
    echo "${content}" > "${MANIFEST}"
}

# Ensure user config has tarion include header
ensure_tarion_include() {
    local app="${1}"
    local skel_file="${2}"
    local basename
    basename=$(basename "${skel_file}")
    local user_conf="${USER_DIR}/${app}/${basename}"
    local rel_path="${app}/${basename}"

    mkdir -p "$(dirname "${user_conf}")"

    if [ ! -f "${user_conf}" ]; then
        # First run: create with tarion include
        cat > "${user_conf}" <<'EOF'
//
//                                     ▄▄▄ ▄▄ ▄▄
//     ██              ▀▀               █  █ ▀ █
//    ▀██▀▀ ▀▀█▄ ████▄ ██  ▄███▄ ████▄
//     ██  ▄█▀██ ██ ▀▀ ██  ██ ██ ██ ██
//     ██  ▀█▄██ ██    ██▄ ▀███▀ ██ ██
//
//  System defaults: keybinds, layout, animations, window rules.
//  Updated when you rebuild Tarion.
//
//  Inspect: bat ~/.local/share/tarion/niri/config.kdl
//

include "~/.local/share/tarion/niri/config.kdl"

// ═══════════════════════════════════════════════════════════════
//   NO EDITS ABOVE THIS LINE - keep the include intact
// ═══════════════════════════════════════════════════════════════

// user config can be placed here
EOF
        log_info "Created ${rel_path} with tarion include"
    elif ! grep -q "TARION MANAGED" "${user_conf}"; then
        # User config exists but no tarion marker - add it (replace with template)
        cat > "${user_conf}" <<'EOF'
//
//                                     ▄▄▄ ▄▄ ▄▄
//     ██              ▀▀               █  █ ▀ █
//    ▀██▀▀ ▀▀█▄ ████▄ ██  ▄███▄ ████▄
//     ██  ▄█▀██ ██ ▀▀ ██  ██ ██ ██ ██
//     ██  ▀█▄██ ██    ██▄ ▀███▀ ██ ██
//
//  System defaults: keybinds, layout, animations, window rules.
//  Updated when you rebuild Tarion.
//
//  Inspect: bat ~/.local/share/tarion/niri/config.kdl
//

include "~/.local/share/tarion/niri/config.kdl"

// ═══════════════════════════════════════════════════════════════
//   NO EDITS ABOVE THIS LINE - keep the include intact
// ═══════════════════════════════════════════════════════════════

// user config can be placed here
EOF
        log_info "Added tarion include to existing ${rel_path}"
    fi
}

# Copy skeleton to local
copy_skel_to_local() {
    local skel_file="${1}"
    local rel_path="${skel_file#"${SKEL_DIR}"/}"
    local local_file="${LOCAL_DIR}/${rel_path}"

    mkdir -p "$(dirname "${local_file}")"
    cp "${skel_file}" "${local_file}"
}

# Sync all apps
sync_apps() {
    local changed_count=0
    local manifest_content=""

    # Walk through skeleton
    while IFS= read -r -d '' skel_file; do
        local rel_path="${skel_file#"${SKEL_DIR}"/}"
        local local_file="${LOCAL_DIR}/${rel_path}"

        # Get app name (first directory)
        local app="${rel_path%%/*}"

        # Skip backup files
        [[ "${rel_path}" == *".save"* ]] && continue

        # Calculate checksums
        local skel_checksum
        skel_checksum=$(sha256_file "${skel_file}")

        local local_checksum=""
        local_checksum=$(sha256_file "${local_file}" 2>/dev/null || echo "")

        local needs_update=false

        if [ ! -f "${local_file}" ]; then
            # New file in skeleton
            needs_update=true
        elif [ "${local_checksum}" != "${skel_checksum}" ]; then
            # Skeleton changed
            needs_update=true
        fi

        if [ "${needs_update}" = true ]; then
            if [ "${LIST_CHANGES}" = true ]; then
                echo -e "${CYAN}${rel_path}${NC}"
            else
                copy_skel_to_local "${skel_file}"
                # Ensure user config has tarion include if this is a config file
                if [[ "${rel_path}" == *".kdl" || "${rel_path}" == *".conf" ]]; then
                    ensure_tarion_include "${app}" "${rel_path}"
                fi
            fi
            changed_count=$((changed_count + 1))
        fi

        manifest_content+="${rel_path}|${skel_checksum}"$'\n'
    done < <(find "${SKEL_DIR}" -type f -print0)

    if [ "${LIST_CHANGES}" = true ]; then
        if [ "${changed_count}" -eq 0 ]; then
            echo "No changes in skeleton"
        else
            echo "${changed_count} file(s) changed"
        fi
    else
        write_manifest "${manifest_content}"
        log_info "Synced ${changed_count} file(s) from skeleton to ${LOCAL_DIR}"
    fi
}

# Show diff between local and user config
show_diff() {
    local file="${1#"${HOME}/.config/"}"
    local local_file="${LOCAL_DIR}/${file}"
    local user_file="${HOME}/.config/${file}"

    if [ ! -f "${local_file}" ]; then
        log_error "No local skeleton found for ${file}"
        exit 1
    fi

    if [ ! -f "${user_file}" ]; then
        log_error "No user config found for ${file}"
        exit 1
    fi

    echo "=== Diff for ${file} ==="
    echo "--- Local (skeleton): ${local_file} ---"
    cat "${local_file}"
    echo ""
    echo "--- User config: ${user_file} ---"
    cat "${user_file}"
}

# Main
main() {
    if [ ! -d "${SKEL_DIR}" ]; then
        log_error "Skeleton directory not found: ${SKEL_DIR}"
        exit 1
    fi

    if [ -n "${SHOW_DIFF_FILE}" ]; then
        show_diff "${SHOW_DIFF_FILE}"
        exit 0
    fi

    if [ "${LIST_CHANGES}" = true ]; then
        echo "=== Skeleton changes ==="
        sync_apps
        exit 0
    fi

    if [ "${FORCE}" = true ]; then
        log_info "Force sync - copying all skeleton files"
    fi

    sync_apps

    # Generate keybindings cache
    if command -v tarion-keybindings-generate &>/dev/null; then
        tarion-keybindings-generate > /dev/null
    fi

    log_info "Tarion sync complete!"
    echo ""
    echo "Your configs are in ${USER_DIR}"
    echo "Skeleton is stored in ${LOCAL_DIR}"
}

main "$@"