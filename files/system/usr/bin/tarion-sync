#!/usr/bin/env bash
# Tarion configuration synchronization utility
# Maintains skeleton configs in ~/.local/share/tarion/ with user overrides in ~/.config/
set -euo pipefail

source /usr/lib/tarion/xdg-paths.sh

SKEL_DIR="/usr/share/tarion/skel"
LOCAL_DIR="${HOME}/.local/share/tarion"
USER_DIR="${HOME}/.config"
STATE_DIR=$(get_tarion_cache_dir)
MANIFEST="${STATE_DIR}/skel-manifest"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

FORCE=false
SHOW_DIFF_FILE=""
LIST_CHANGES=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --force)
            FORCE=true
            shift
            ;;
        --diff)
            SHOW_DIFF_FILE="$2"
            shift 2
            ;;
        --list)
            LIST_CHANGES=true
            shift
            ;;
        *)
            echo "Usage: tarion-sync [--force] [--diff <file>] [--list]"
            exit 1
            ;;
    esac
done

log_info() { echo -e "${GREEN}✓${NC} $*"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $*"; }
log_error() { echo -e "${RED}✗${NC} $*" >&2; }

# Get file SHA256
sha256_file() {
    sha256sum "${1}" 2>/dev/null | awk '{print $1}'
}

# Read manifest
read_manifest() {
    if [ -f "${MANIFEST}" ]; then
        cat "${MANIFEST}"
    fi
}

# Write manifest
write_manifest() {
    local content="${1}"
    mkdir -p "$(dirname "${MANIFEST}")"
    echo "${content}" > "${MANIFEST}"
}

# Entry-point configs that get a user-side include stub in ~/.config.
# Everything else in the skeleton is pulled in transitively from
# ~/.local/share/tarion/ by these entry points and must NOT be stubbed
# (e.g. niri/config.kdl includes bindings.kdl, autostart.kdl, dms/*.kdl).
is_entry_point() {
    case "${1}" in
        niri/config.kdl) return 0 ;;
        *) return 1 ;;
    esac
}

# Write the managed user-side stub that includes the system default for rel_path.
write_tarion_stub() {
    local rel_path="${1}"
    local user_conf="${USER_DIR}/${rel_path}"
    cat > "${user_conf}" <<EOF
//
//                                     ▄▄▄ ▄▄ ▄▄
//     ██              ▀▀               █  █ ▀ █
//    ▀██▀▀ ▀▀█▄ ████▄ ██  ▄███▄ ████▄
//     ██  ▄█▀██ ██ ▀▀ ██  ██ ██ ██ ██
//     ██  ▀█▄██ ██    ██▄ ▀███▀ ██ ██
//
//  System defaults: keybinds, layout, animations, window rules.
//  Updated when you rebuild Tarion.
//
//  Inspect: bat ~/.local/share/tarion/${rel_path}
//

include "~/.local/share/tarion/${rel_path}"

// ═══════════════════════════════════════════════════════════════
//   NO EDITS ABOVE THIS LINE - keep the include intact
// ═══════════════════════════════════════════════════════════════

// user config can be placed here
EOF
}

# Ensure the user's entry-point config carries the tarion include.
# Existing files that already include the default are left untouched so
# user customizations below the include line are preserved.
ensure_tarion_include() {
    local rel_path="${1}"
    local user_conf="${USER_DIR}/${rel_path}"
    local include_line="include \"~/.local/share/tarion/${rel_path}\""

    mkdir -p "$(dirname "${user_conf}")"

    if [ ! -f "${user_conf}" ]; then
        write_tarion_stub "${rel_path}"
        log_info "Created ${rel_path} with tarion include"
    elif ! grep -qF "${include_line}" "${user_conf}"; then
        # Existing file without our include: back it up before replacing
        # so we never silently destroy user content.
        cp "${user_conf}" "${user_conf}.bak.$(date +%Y%m%d%H%M%S)"
        write_tarion_stub "${rel_path}"
        log_warn "Replaced ${rel_path} with tarion include (backup saved)"
    fi
}

# Copy skeleton to local
copy_skel_to_local() {
    local skel_file="${1}"
    local rel_path="${skel_file#"${SKEL_DIR}"/}"
    local local_file="${LOCAL_DIR}/${rel_path}"

    mkdir -p "$(dirname "${local_file}")"
    cp "${skel_file}" "${local_file}"
}

# Seed DMS-managed niri configs into ~/.config/niri/dms/.
# DMS writes these files itself at runtime, and config.kdl includes them by
# absolute path, so we only seed defaults when a target is missing — existing
# DMS/user files are never overwritten (not even on --force).
seed_dms_config() {
    local dms_skel="${SKEL_DIR}/niri/dms"
    [ -d "${dms_skel}" ] || return 0

    local seeded=0 skel_file rel_path dest
    while IFS= read -r -d '' skel_file; do
        rel_path="${skel_file#"${dms_skel}"/}"
        dest="${USER_DIR}/niri/dms/${rel_path}"
        if [ ! -e "${dest}" ]; then
            mkdir -p "$(dirname "${dest}")"
            cp "${skel_file}" "${dest}"
            seeded=$((seeded + 1))
        fi
    done < <(find "${dms_skel}" -type f -print0)

    [ "${seeded}" -gt 0 ] && log_info "Seeded ${seeded} DMS config(s) into ${USER_DIR}/niri/dms"
    return 0
}

# Sync all apps
sync_apps() {
    local changed_count=0
    local manifest_content=""

    # Walk through skeleton
    while IFS= read -r -d '' skel_file; do
        local rel_path="${skel_file#"${SKEL_DIR}"/}"
        local local_file="${LOCAL_DIR}/${rel_path}"

        # Skip backup files
        [[ "${rel_path}" == *".save"* ]] && continue

        # DMS-managed configs are seeded into ~/.config/niri/dms/ by
        # seed_dms_config() (DMS owns them at runtime); never route them
        # through the local-dir include chain.
        [[ "${rel_path}" == niri/dms/* ]] && continue

        # Calculate checksums
        local skel_checksum
        skel_checksum=$(sha256_file "${skel_file}")

        local local_checksum=""
        local_checksum=$(sha256_file "${local_file}" 2>/dev/null || echo "")

        local needs_update=false

        if [ ! -f "${local_file}" ]; then
            # New file in skeleton
            needs_update=true
        elif [ "${local_checksum}" != "${skel_checksum}" ]; then
            # Skeleton changed
            needs_update=true
        fi

        if [ "${needs_update}" = true ]; then
            if [ "${LIST_CHANGES}" = true ]; then
                echo -e "${CYAN}${rel_path}${NC}"
            else
                copy_skel_to_local "${skel_file}"
                # Only entry-point configs get a user-side include stub;
                # transitively-included files live solely in ${LOCAL_DIR}.
                if is_entry_point "${rel_path}"; then
                    ensure_tarion_include "${rel_path}"
                fi
            fi
            changed_count=$((changed_count + 1))
        fi

        manifest_content+="${rel_path}|${skel_checksum}"$'\n'
    done < <(find "${SKEL_DIR}" -type f -print0)

    if [ "${LIST_CHANGES}" = true ]; then
        if [ "${changed_count}" -eq 0 ]; then
            echo "No changes in skeleton"
        else
            echo "${changed_count} file(s) changed"
        fi
    else
        write_manifest "${manifest_content}"
        log_info "Synced ${changed_count} file(s) from skeleton to ${LOCAL_DIR}"
    fi
}

# Show diff between local and user config
show_diff() {
    local file="${1#"${HOME}/.config/"}"
    local local_file="${LOCAL_DIR}/${file}"
    local user_file="${HOME}/.config/${file}"

    if [ ! -f "${local_file}" ]; then
        log_error "No local skeleton found for ${file}"
        exit 1
    fi

    if [ ! -f "${user_file}" ]; then
        log_error "No user config found for ${file}"
        exit 1
    fi

    echo "=== Diff for ${file} ==="
    echo "--- Local (skeleton): ${local_file} ---"
    cat "${local_file}"
    echo ""
    echo "--- User config: ${user_file} ---"
    cat "${user_file}"
}

# Main
main() {
    if [ ! -d "${SKEL_DIR}" ]; then
        log_error "Skeleton directory not found: ${SKEL_DIR}"
        exit 1
    fi

    if [ -n "${SHOW_DIFF_FILE}" ]; then
        show_diff "${SHOW_DIFF_FILE}"
        exit 0
    fi

    if [ "${LIST_CHANGES}" = true ]; then
        echo "=== Skeleton changes ==="
        sync_apps
        exit 0
    fi

    if [ "${FORCE}" = true ]; then
        log_info "Force sync - copying all skeleton files"
    fi

    sync_apps
    seed_dms_config

    # Generate keybindings cache
    if command -v tarion-keybindings-generate &>/dev/null; then
        tarion-keybindings-generate > /dev/null
    fi

    log_info "Tarion sync complete!"
    echo ""
    echo "Your configs are in ${USER_DIR}"
    echo "Skeleton is stored in ${LOCAL_DIR}"
}

main "$@"