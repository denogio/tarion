#!/usr/bin/env bash
# Tarion Screenshot Tool
# Uses DMS screenshot with Satty editor for Fedora Atomic

OUTDIR="${HOME}/Pictures/screenshots"

selection=$(echo "Entire Screen
Window
Region" | vicinae dmenu -p "Screenshot mode..." --no-section --no-metadata 2>/dev/null)

case "${selection}" in
  *Entire*)
    # Pipe to Satty if available, otherwise save directly
    if command -v satty &> /dev/null; then
        dms screenshot full --stdout | satty --filename -
    else
        dms screenshot full -d "${OUTDIR}"
    fi
    ;;
  *Window*)
    if command -v satty &> /dev/null; then
        dms screenshot window --stdout | satty --filename -
    else
        dms screenshot window -d "${OUTDIR}"
    fi
    ;;
  *Region*)
    if command -v satty &> /dev/null; then
        dms screenshot --stdout | satty --filename -
    else
        dms screenshot -d "${OUTDIR}"
    fi
    ;;
  *)
    echo "Cancelled"
    ;;
esac
