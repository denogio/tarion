#!/usr/bin/env bash
# tarion-firstboot — First-boot user setup (runs once per task via systemd user service)
# Part of the Tarion desktop distribution.
set -euo pipefail

source /usr/lib/tarion/xdg-paths.sh

STATE_FILE="$(get_tarion_file "state" "setup-state.json")"
OLD_STATE_FILE="${HOME}/.config/tarion/setup-state.json"

# Migrate state file from old config location to XDG state dir
if [[ -f "${OLD_STATE_FILE}" && ! -f "${STATE_FILE}" ]]; then
    mkdir -p "$(dirname "${STATE_FILE}")"
    mv "${OLD_STATE_FILE}" "${STATE_FILE}"
fi

_state_get() {
    local key="${1}"
    if [[ -f "${STATE_FILE}" ]]; then
        jq -r --arg k "${key}" '.[$k] // false' "${STATE_FILE}"
    else
        echo "false"
    fi
}

_state_set() {
    local key="${1}"
    local tmp
    tmp="$(mktemp)"
    if [[ -f "${STATE_FILE}" ]]; then
        jq --arg k "${key}" '.[$k] = true' "${STATE_FILE}" > "${tmp}"
    else
        jq -n --arg k "${key}" '{($k): true}' > "${tmp}"
    fi
    mkdir -p "$(dirname "${STATE_FILE}")"
    mv "${tmp}" "${STATE_FILE}"
}

# Task: greeter sync
if [[ "$(_state_get greeter_sync)" != "true" ]]; then
    if command -v dms &>/dev/null; then
        if dms greeter sync; then _state_set greeter_sync; fi
    fi
fi

# Task: install DankKDEConnect plugin
if [[ "$(_state_get dms_plugin_kdeconnect)" != "true" ]]; then
    if command -v dms &>/dev/null; then
        dms plugins install dankKDEConnect 2>/dev/null || true
        _state_set dms_plugin_kdeconnect
    fi
fi
