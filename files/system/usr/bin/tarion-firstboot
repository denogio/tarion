#!/usr/bin/env bash
# tarion-firstboot — First-boot user setup (runs once per task via systemd user service)
# Part of the Tarion desktop distribution.
set -euo pipefail

STATE_FILE="${HOME}/.config/tarion/setup-state.json"

_state_get() {
    local key="${1}"
    if [[ -f "${STATE_FILE}" ]]; then
        jq -r --arg k "${key}" '.[$k] // false' "${STATE_FILE}"
    else
        echo "false"
    fi
}

_state_set() {
    local key="${1}"
    local tmp
    tmp="$(mktemp)"
    if [[ -f "${STATE_FILE}" ]]; then
        jq --arg k "${key}" '.[$k] = true' "${STATE_FILE}" > "${tmp}"
    else
        jq -n --arg k "${key}" '{($k): true}' > "${tmp}"
    fi
    mkdir -p "${HOME}/.config/tarion"
    mv "${tmp}" "${STATE_FILE}"
}

# Task: greeter install
if [[ "$(_state_get greeter_install)" != "true" ]]; then
    if command -v dms &>/dev/null; then
        if dms greeter install; then _state_set greeter_install; fi
    fi
fi

# Task: greeter sync
if [[ "$(_state_get greeter_sync)" != "true" ]]; then
    if command -v dms &>/dev/null; then
        if dms greeter sync; then _state_set greeter_sync; fi
    fi
fi

# Task: install pyyaml for brew python (required by hypr-pop-windows-gen)
if [[ "$(_state_get pip_pyyaml)" != "true" ]]; then
    if /home/linuxbrew/.linuxbrew/bin/pip3 install --quiet pyyaml; then _state_set pip_pyyaml; fi
fi

# Task: install DankKDEConnect plugin
if [[ "$(_state_get dms_plugin_kdeconnect)" != "true" ]]; then
    if command -v dms &>/dev/null; then
        if dms plugins install dankKDEConnect; then _state_set dms_plugin_kdeconnect; fi
    fi
fi
