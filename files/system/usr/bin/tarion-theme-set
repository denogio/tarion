#!/usr/bin/env bash
set -euo pipefail
# Tarion Theme Selector - DMS Native Theming Edition
# Uses DMS's built-in theme system instead of custom theme files

# Source XDG helper
source /usr/lib/tarion/xdg-paths.sh

# DMS theme mapping - map Tarion theme names to DMS theme IDs
declare -A DMS_THEME_MAP=(
    ["catppuccin-mocha"]="catppuccin-mocha"
    ["catppuccin-latte"]="catppuccin-latte"
    ["catppuccin"]="catppuccin"
    ["tokyo-night"]="tokyo-night"
    ["gruvbox"]="gruvbox"
    ["rose-pine"]="rose-pine"
    ["flexoki-light"]="flexoki-light"
    ["everforest"]="everforest"
    ["kanagawa"]="kanagawa"
    ["matte-black"]="matte-black"
    ["nord"]="nord"
    ["osaka-jade"]="osaka-jade"
    ["ristretto"]="ristretto"
)

show_usage() {
    cat << EOF
Usage: tarion-theme-set <theme-name>
       tarion-theme-set --list
       tarion-theme-set --current
       tarion-theme-set --help

Available themes:
  catppuccin-mocha    catppuccin-latte    catppuccin
  tokyo-night        gruvbox             rose-pine
  flexoki-light      everforest          kanagawa
  matte-black        nord                osaka-jade
  ristretto

This command uses DMS's native theme system. Themes are installed from
the DMS theme registry and applied system-wide via matugen.
EOF
}

list_themes() {
    echo "Available Tarion themes (mapped to DMS themes):"
    for theme in "${!DMS_THEME_MAP[@]}"; do
        echo "  ${theme}"
    done
    echo ""
    echo "To browse all available DMS themes, use: dms settings openWith theme"
}

get_current_theme() {
    if command -v dms >/dev/null 2>&1 && pgrep -x dms >/dev/null; then
        echo "Current DMS theme mode: $(dms ipc call theme getMode 2>/dev/null || echo "unknown")"
    else
        echo "DMS is not running"
    fi
    
    # Check if we have a stored theme name
    local theme_file
    theme_file=$(get_tarion_file "config" "current/theme.name" 2>/dev/null || true)
    if [[ -f "${theme_file}" ]]; then
        echo "Last Tarion theme: $(cat "${theme_file}")"
    fi
}

install_dms_theme() {
    local theme_id="$1"
    
    echo "Installing DMS theme: ${theme_id}"
    
    # Check if DMS is installed
    if ! command -v dms >/dev/null 2>&1; then
        echo "Error: DMS is not installed. Please install DankMaterialShell first."
        return 1
    fi
    
    # Try to install theme via DMS URI scheme
    if xdg-open "dms://theme/install/${theme_id}" >/dev/null 2>&1; then
        echo "Theme installation initiated via DMS registry"
        return 0
    fi
    
    # Fallback: Use DMS settings to open theme browser
    echo "Note: Manual theme installation required"
    echo "Please open DMS Settings → Themes and install: ${theme_id}"
    echo "Or visit: https://danklinux.com/plugins?tab=themes"
    
    return 0
}

apply_dms_theme() {
    local theme_name="$1"
    local dms_theme_id="${DMS_THEME_MAP[${theme_name}]}"
    
    if [[ -z "${dms_theme_id}" ]]; then
        echo "Error: Theme '${theme_name}' is not mapped to a DMS theme."
        echo "Available themes: ${!DMS_THEME_MAP[*]}"
        return 1
    fi
    
    # Store theme name for reference
    local theme_file
    theme_file=$(get_tarion_file "config" "current/theme.name")
    mkdir -p "$(dirname "${theme_file}")"
    echo "${theme_name}" > "${theme_file}"
    
    echo "Applying theme: ${theme_name} (DMS: ${dms_theme_id})"
    
    # Check if DMS is running
    if ! pgrep -x dms >/dev/null; then
        echo "Warning: DMS is not running. Theme will be applied when DMS starts."
        echo "Start DMS with: systemctl --user start dms"
    fi
    
    # Apply theme via DMS IPC
    # Note: DMS handles theme switching internally via settings
    # The user should use DMS Settings UI or install themes from registry
    
    echo ""
    echo "To apply this theme:"
    echo "1. Ensure the theme is installed from DMS theme registry"
    echo "2. Open DMS Settings → Themes"
    echo "3. Select '${dms_theme_id}' from the theme browser"
    echo ""
    echo "DMS will automatically generate application themes via matugen."
    
    return 0
}

# Main execution
main() {
    if [[ $# -eq 0 ]]; then
        show_usage
        exit 1
    fi
    
    case "$1" in
        --help|-h)
            show_usage
            exit 0
            ;;
        --list|-l)
            list_themes
            exit 0
            ;;
        --current|-c)
            get_current_theme
            exit 0
            ;;
        --install|-i)
            if [[ -z "$2" ]]; then
                echo "Error: Theme name required for installation"
                exit 1
            fi
            install_dms_theme "$2"
            exit $?
            ;;
        *)
            # Normal theme application
            apply_dms_theme "$1"
            exit $?
            ;;
    esac
}

main "$@"
