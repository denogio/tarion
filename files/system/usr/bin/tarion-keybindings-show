#!/usr/bin/env bash
set -euo pipefail

check_dependencies() {
  local deps=("dms" "vicinae")
  local missing_deps=()
  
  for dep in "${deps[@]}"; do
    if ! command -v "${dep}" &>/dev/null; then
      missing_deps+=("${dep}")
    fi
  done
  
  if [[ ${#missing_deps[@]} -gt 0 ]]; then
    echo "Error: Missing dependencies:" >&2
    for dep in "${missing_deps[@]}"; do
      echo "  - ${dep}" >&2
    done
    
    if [[ " ${missing_deps[*]} " =~ " dms " ]]; then
      echo "DMS is required for keybindings display" >&2
      echo "Ensure DMS is installed and running" >&2
    fi
    
    if [[ " ${missing_deps[*]} " =~ " vicinae " ]]; then
      echo "Vicinae is required for keybindings menu" >&2
      echo "Ensure Vicinae is installed and running" >&2
    fi
    
    return 1
  fi
}

declare -a CATEGORIES=(
  "Apps"
  "Media"
  "Utilities"
  "Window Management"
  "Scrolling"
  "Clipboard"
)

display_category() {
  local category="$1"

  local bindings
  bindings=$(dms keybinds list --category "${category}" --format json 2>/dev/null | jq -r '.[] | "\(.key) → \(.description)"' 2>/dev/null || echo "")

  if [[ -z "${bindings}" ]]; then
    echo "No bindings in this category" >&2
    return
  fi

  echo "${bindings}" | vicinae dmenu --prompt "Keybindings: ${category}"
}

display_all() {
  local all_bindings=""
  
  for category in "${CATEGORIES[@]}"; do
    local category_bindings
    category_bindings=$(dms keybinds list --category "${category}" --format json 2>/dev/null | jq -r '.[] | "\(.key) → \(.description) [${category}]"' 2>/dev/null || echo "")
    
    if [[ -n "${category_bindings}" ]]; then
      all_bindings+="${category_bindings}"$'\n'
    fi
  done

  if [[ -z "${all_bindings}" ]]; then
    echo "No keybindings found" >&2
    return 1
  fi

  echo "${all_bindings}" | vicinae dmenu --prompt "All Keybindings"
}

search_bindings() {
  local query="$1"

  local matches
  matches=$(dms keybinds search "${query}" --format json 2>/dev/null | jq -r '.[] | "\(.key) → \(.description) [\(.category)]"' 2>/dev/null || echo "")

  if [[ -z "${matches}" ]]; then
    echo "No matches found for: ${query}" >&2
    return 1
  fi

  echo "${matches}" | vicinae dmenu --prompt "Search: ${query}"
}

main_menu() {
  local selection
  selection=$(printf "%s\n" "${CATEGORIES[@]}" "Search..." "Show All" | vicinae dmenu --prompt "Keybindings Menu")
  
  case "${selection}" in
    "Search...")
      local query
      query=$(vicinae dmenu --prompt "Search keybindings:")
      search_bindings "${query}"
      ;;
    "Show All")
      display_all
      ;;
    *)
      if [[ -n "${selection}" ]]; then
        display_category "${selection}"
      fi
      ;;
  esac
}

show_usage() {
  cat << 'EOF'
Usage: tarion-keybindings-show [OPTIONS]

Display Tarion keybindings using Vicinae dmenu.

OPTIONS:
  --all, -a           Show all bindings
  --category, -c CAT  Show specific category
  --search, -s QUERY   Search bindings
  --help, -h           Show this help message

CATEGORIES:
  Apps                 Application launchers
  Media                Volume, brightness, media controls
  Utilities            Menus, screenshots, wallpapers
  Window Management    Focus, resize, workspace navigation
  Scrolling            Column-based tiling bindings
  Clipboard            Copy/paste shortcuts

EXAMPLES:
  tarion-keybindings-show           # Interactive menu
  tarion-keybindings-show --all      # Show all bindings
  tarion-keybindings-show -c Media   # Show media bindings
  tarion-keybindings-show -s fullscreen  # Search for fullscreen

EOF
}

main() {
  check_dependencies || exit 1

  local mode="menu"
  local query=""
  local category=""

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --all|-a)
        mode="all"
        shift
        ;;
      --category|-c)
        mode="category"
        category="${2}"
        shift 2
        ;;
      --search|-s)
        mode="search"
        query="${2}"
        shift 2
        ;;
      --help|-h)
        show_usage
        exit 0
        ;;
      *)
        echo "Unknown option: ${1}" >&2
        show_usage >&2
        exit 1
        ;;
    esac
  done

  case "${mode}" in
    all)
      display_all
      ;;
    category)
      if [[ -z "${category}" ]]; then
        echo "Error: --category requires a value" >&2
        exit 1
      fi
      display_category "${category}"
      ;;
    search)
      if [[ -z "${query}" ]]; then
        echo "Error: --search requires a value" >&2
        exit 1
      fi
      search_bindings "${query}"
      ;;
    *)
      main_menu
      ;;
  esac
}

main "$@"
