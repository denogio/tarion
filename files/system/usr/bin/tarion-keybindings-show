#!/usr/bin/env bash
set -euo pipefail

# Map Hyprland key codes to human-readable names
declare -A KEYCODE_MAP=(
  ["code:10"]="1"
  ["code:11"]="2"
  ["code:12"]="3"
  ["code:13"]="4"
  ["code:14"]="5"
  ["code:15"]="6"
  ["code:16"]="7"
  ["code:17"]="8"
  ["code:18"]="9"
  ["code:19"]="0"
  ["code:20"]="-"
  ["code:21"]="="
  ["mouse:272"]="󰍽"  # Left mouse button (mouse icon)
  ["mouse:273"]="󰍽"  # Right mouse button (mouse icon)
  ["mouse_down"]="󰁿"  # Scroll Down (down arrow)
  ["mouse_up"]="󰁹"    # Scroll Up (up arrow)
  ["XF86AudioRaiseVolume"]="󰝝"  # Volume up
  ["XF86AudioLowerVolume"]="󰝞"  # Volume down
  ["XF86AudioMute"]="󰝟"        # Mute
  ["XF86AudioMicMute"]="󰍬"     # Mic mute
  ["XF86MonBrightnessUp"]="󰃠"   # Brightness up
  ["XF86MonBrightnessDown"]="󰃞" # Brightness down
  ["XF86AudioNext"]="󰒭"        # Next track
  ["XF86AudioPause"]="󰏤"       # Pause
  ["XF86AudioPlay"]="󰏤"        # Play
  ["XF86AudioPrev"]="󰒮"        # Previous track
  ["PRINT"]="󰹑"                # Print screen
)

# Convert Hyprland key format to human-readable
format_key() {
  local key="$1"
  
  # First replace special function keys with icons
  for code in "${!KEYCODE_MAP[@]}"; do
    if [[ "${key}" == *"${code}"* ]]; then
      key="${key//${code}/${KEYCODE_MAP[${code}]}}"
    fi
  done
  
  # Replace modifiers with symbols (in correct order)
  local formatted=""
  # Split by + to handle each part
  IFS='+' read -ra parts <<< "${key}"
  for part in "${parts[@]}"; do
    case "${part}" in
      SUPER) formatted+=" " ;;   # Super key (Fedora logo)
      ALT) formatted+="󰘵 " ;;     # Alt key
      CTRL) formatted+="󰘴 " ;;   # Ctrl key
      SHIFT) formatted+="󰘶 " ;;  # Shift key
      RETURN|ENTER) formatted+="󰌑 " ;;  # Return/Enter key
      SPACE) formatted+="󱁐 " ;;   # Space key
      TAB) formatted+="󰌒 " ;;     # Tab key
      DELETE) formatted+="󰆴 " ;;  # Delete key
      BACKSPACE) formatted+="󰌍 " ;; # Backspace key
      COMMA) formatted+="," ;;    # Comma
      PERIOD) formatted+="." ;;   # Period
      LEFT) formatted+="󰁍 " ;;    # Left arrow
      RIGHT) formatted+="󰁔 " ;;   # Right arrow
      UP) formatted+="󰁝 " ;;      # Up arrow
      DOWN) formatted+="󰁅 " ;;    # Down arrow
      *) formatted+="${part} " ;;
    esac
  done
  
  # Remove trailing space and clean up
  formatted="${formatted% }"
  # Replace double spaces with single space
  formatted="${formatted//  / }"
  echo "${formatted}"
}

# Fallback keybindings if DMS is not available or returns empty
get_fallback_bindings() {
  local category="$1"
  
  # Basic fallback keybindings from Hyprland config
  case "${category}" in
    Execute)
      echo "SUPER, SPACE|Launch apps (Vicinae)
SUPER, K|Show key bindings
SUPER, L|Lock screen
SUPER, W|Random wallpaper
SUPER ALT, W|Next wallpaper
SUPER CTRL, W|Previous wallpaper
SUPER CTRL, I|Toggle idle inhibit
, PRINT|Screenshot region with Satty
SUPER, PRINT|Screenshot menu
SUPER SHIFT, PRINT|Color picker"
      ;;
    Window)
      echo "SUPER, Q|Close window
SUPER, F|Toggle fullscreen
SUPER, V|Toggle floating
ALT, TAB|Switch windows
SUPER, TAB|Switch workspaces"
      ;;
    Workspace)
      echo "SUPER, 1|Workspace 1
SUPER, 2|Workspace 2
SUPER, 3|Workspace 3
SUPER, 4|Workspace 4
SUPER, 5|Workspace 5
SUPER, left|Move focus left
SUPER, right|Move focus right
SUPER, up|Move focus up
SUPER, down|Move focus down"
      ;;
    Other)
      echo "XF86AudioRaiseVolume|Volume up
XF86AudioLowerVolume|Volume down
XF86AudioMute|Mute
XF86MonBrightnessUp|Brightness up
XF86MonBrightnessDown|Brightness down
XF86AudioNext|Next track
XF86AudioPlay|Play/Pause
XF86AudioPrev|Previous track"
      ;;
    *)
      echo ""
      ;;
  esac
}

check_dependencies() {
  local deps=("dms" "vicinae")
  local missing_deps=()
  
  for dep in "${deps[@]}"; do
    if ! command -v "${dep}" &>/dev/null; then
      missing_deps+=("${dep}")
    fi
  done
  
  if [[ ${#missing_deps[@]} -gt 0 ]]; then
    echo "Error: Missing dependencies:" >&2
    for dep in "${missing_deps[@]}"; do
      echo "  - ${dep}" >&2
    done
    
    if [[ " ${missing_deps[*]} " =~ " dms " ]]; then
      echo "DMS is required for keybindings display" >&2
      echo "Ensure DMS is installed and running" >&2
    fi
    
    if [[ " ${missing_deps[*]} " =~ " vicinae " ]]; then
      echo "Vicinae is required for keybindings menu" >&2
      echo "Ensure Vicinae is installed and running" >&2
    fi
    
    return 1
  fi
}

declare -a CATEGORIES=(
  "Execute"
  "Window"
  "Workspace"
  "Other"
)

display_category() {
  local category="$1"

  local bindings
  bindings=$(dms keybinds show hyprland 2>/dev/null | jq -r --arg cat "${category}" '.binds[$cat]? // [] | .[] | "\(.key)|\(.desc)"' || echo "")

  # Fallback if DMS returns empty or fails
  if [[ -z "${bindings}" ]]; then
    bindings=$(get_fallback_bindings "${category}")
  fi

  if [[ -z "${bindings}" ]]; then
    echo "No bindings in this category" >&2
    return
  fi

  # Format each line
  local formatted_bindings=""
  while IFS='|' read -r key desc; do
    if [[ -n "${key}" && -n "${desc}" ]]; then
      formatted_key=$(format_key "${key}")
      formatted_bindings+="${formatted_key} → ${desc}"$'\n'
    fi
  done <<< "${bindings}"

  echo "${formatted_bindings}" | vicinae dmenu -p "Keybindings: ${category}" --no-section --no-quick-look --no-metadata
}

display_all() {
  local all_bindings
  all_bindings=$(dms keybinds show hyprland 2>/dev/null | jq -r '.binds | to_entries[] | .key as $cat | .value[] | "\(.key)|\(.desc)|\($cat)"' || echo "")
  
  # Fallback if DMS returns empty or fails
  if [[ -z "${all_bindings}" ]]; then
    for category in "${CATEGORIES[@]}"; do
      fallback=$(get_fallback_bindings "${category}")
      while IFS='|' read -r key desc; do
        if [[ -n "${key}" && -n "${desc}" ]]; then
          all_bindings+="${key}|${desc}|${category}"$'\n'
        fi
      done <<< "${fallback}"
    done
  fi
  
  if [[ -z "${all_bindings}" ]]; then
    echo "No keybindings found" >&2
    return 1
  fi

  # Format each line
  local formatted_bindings=""
  while IFS='|' read -r key desc category; do
    if [[ -n "${key}" && -n "${desc}" ]]; then
      formatted_key=$(format_key "${key}")
      formatted_bindings+="${formatted_key} → ${desc} [${category}]"$'\n'
    fi
  done <<< "${all_bindings}"

  echo "${formatted_bindings}" | vicinae dmenu -p "All Keybindings" --no-section --no-quick-look --no-metadata
}

search_bindings() {
  local query="$1"

  local matches
  matches=$(dms keybinds show hyprland 2>/dev/null | jq -r --arg q "${query}" '.binds | to_entries[] | .key as $cat | .value[] | select(.desc | ascii_downcase | contains($q | ascii_downcase) or .key | ascii_downcase | contains($q | ascii_downcase)) | "\(.key)|\(.desc)|\($cat)"' || echo "")

  if [[ -z "${matches}" ]]; then
    echo "No matches found for: ${query}" >&2
    return 1
  fi

  # Format each line
  local formatted_matches=""
  while IFS='|' read -r key desc category; do
    if [[ -n "${key}" && -n "${desc}" ]]; then
      formatted_key=$(format_key "${key}")
      formatted_matches+="${formatted_key} → ${desc} [${category}]"$'\n'
    fi
  done <<< "${matches}"

  echo "${formatted_matches}" | vicinae dmenu -p "Search: ${query}" --no-section --no-quick-look --no-metadata
}

main_menu() {
  local selection
  selection=$(printf "%s\n" "${CATEGORIES[@]}" "Search..." "Show All" | vicinae dmenu -p "Keybindings Menu" --no-section --no-quick-look --no-metadata)
  
  case "${selection}" in
    "Search...")
      local query
       query=$(vicinae dmenu -p "Search keybindings:" --no-section --no-quick-look --no-metadata)
      search_bindings "${query}"
      ;;
    "Show All")
      display_all
      ;;
    *)
      if [[ -n "${selection}" ]]; then
        display_category "${selection}"
      fi
      ;;
  esac
}

show_usage() {
  cat << 'EOF'
Usage: tarion-keybindings-show [OPTIONS]

Display Tarion keybindings using Vicinae dmenu.

OPTIONS:
  --all, -a           Show all bindings
  --category, -c CAT  Show specific category
  --search, -s QUERY   Search bindings
  --help, -h           Show this help message

CATEGORIES:
  Execute              Application launchers and commands
  Window               Window management and focus
  Workspace            Workspace navigation and management
  Other                Miscellaneous bindings

EXAMPLES:
  tarion-keybindings-show           # Interactive menu
  tarion-keybindings-show --all      # Show all bindings
  tarion-keybindings-show -c Media   # Show media bindings
  tarion-keybindings-show -s fullscreen  # Search for fullscreen

EOF
}

main() {
  check_dependencies || exit 1

  local mode="menu"
  local query=""
  local category=""

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --all|-a)
        mode="all"
        shift
        ;;
      --category|-c)
        mode="category"
        category="${2}"
        shift 2
        ;;
      --search|-s)
        mode="search"
        query="${2}"
        shift 2
        ;;
      --help|-h)
        show_usage
        exit 0
        ;;
      *)
        echo "Unknown option: ${1}" >&2
        show_usage >&2
        exit 1
        ;;
    esac
  done

  case "${mode}" in
    all)
      display_all
      ;;
    category)
      if [[ -z "${category}" ]]; then
        echo "Error: --category requires a value" >&2
        exit 1
      fi
      display_category "${category}"
      ;;
    search)
      if [[ -z "${query}" ]]; then
        echo "Error: --search requires a value" >&2
        exit 1
      fi
      search_bindings "${query}"
      ;;
    *)
      main_menu
      ;;
  esac
}

main "$@"
