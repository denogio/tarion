#!/usr/bin/env bash
set -euo pipefail

# Launch a floating terminal with the Tarion logo presentation, 
# then execute the command passed in, and finally end with the tarion-show-done presentation.
# Used by actions such as Update System.

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 <command> [args...]"
    exit 1
fi

cmd="$*"

# Scripts are now in /usr/bin/
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.tarion.terminal --title=Tarion -e bash -c "tarion-show-logo; ${cmd}; if [ \$? -ne 130 ]; then tarion-show-done; fi"
